{
  "name": "@iterate-com/kit",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "description": "A tiny browser-based installer for Iterate voice devices.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "pnpm routes:check && tsc --noEmit",
    "lint": "oxlint . --deny-warnings --report-unused-disable-directives-severity error",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "deploy": "node scripts/app.ts deploy",
    "routes:generate": "node scripts/app.ts generate-route-tree",
    "routes:check": "node scripts/app.ts generate-route-tree --check",
    "test": "vitest run",
    "firmware:configure": "python3 firmware/tools/generate-atlases.py && cmake -S firmware -B firmware/.build/host -DCMAKE_BUILD_TYPE=Debug -DITERATE_KIT_SANITIZE=ON",
    "firmware:build:host": "pnpm firmware:configure && cmake --build firmware/.build/host --parallel",
    "firmware:test:host": "pnpm firmware:build:host && ctest --test-dir firmware/.build/host --output-on-failure",
    "firmware:build": "node ./scripts/firmware-release.ts build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@iterate-com/voice": "https://pkg.pr.new/iterate/iterate/@iterate-com/voice@a5a07e8",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-start": "1.168.58",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "esp-web-tools": "^10.4.0",
    "iterate": "https://pkg.pr.new/iterate/iterate/iterate@a5a07e8",
    "lucide-react": "^1.48.0",
    "next-themes": "^0.4.6",
    "posthog-js": "1.434.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.1",
    "@cloudflare/workers-types": "^5.20260929.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-generator": "1.167.38",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "shadcn": "4.21.0",
    "tailwindcss": "^4.3.3",
    "trpc-cli": "0.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "4.143.1"
  },
  "packageManager": "pnpm@10.24.0"
}
