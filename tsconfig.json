{
  // Worker and browser code in one program, built by Vite; the scripts run on plain node.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types", "node", "vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // Off for Start apps: Start's docs warn it can leak server code into the client bundle
    // (iterate/iterate#2904).
    "verbatimModuleSyntax": false,
    "erasableSyntaxOnly": true,
    "noUncheckedSideEffectImports": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": ["src", "scripts", "envs.ts", "vite.config.ts", "vitest.config.ts"]
}
